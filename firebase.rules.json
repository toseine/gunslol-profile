{
  "rules": {
    "site": {
      "settings": {
        ".read": true,
        ".write": "auth !== null && auth.uid === 'WKLEJ_UID_ADMINA'",
        ".validate": "newData.hasChildren(['name', 'bio', 'videoUrl', 'musicUrl', 'snowEnabled', 'discordUrl', 'githubUrl', 'youtubeUrl'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
        "bio": { ".validate": "newData.isString() && newData.val().length <= 140" },
        "videoUrl": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "musicUrl": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "snowEnabled": { ".validate": "newData.isBoolean()" },
        "discordUrl": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "githubUrl": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "youtubeUrl": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "$other": { ".validate": false }
      }
    }
  }
}
